# Template for /etc/thewolf/prod.env and /etc/thewolf/preview.env on the server.
# Root-owned, mode 600: sudo install -m 600 -o root -g root /dev/null /etc/thewolf/prod.env
# Never commit real values.

# prod: 3000, preview: 3001. The app only listens on localhost; Caddy is the front door.
PORT=3000
HOST=127.0.0.1

# The public URL. prod: https://thewolf.example, preview: https://preview.thewolf.example
ORIGIN=https://thewolf.example
BETTER_AUTH_URL=https://thewolf.example

# prod only. The preview's database URL is written by CI on every preview deploy.
DATABASE_URL=postgres://...?sslmode=require

# 32+ random characters, different per slot: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Same value on both slots, so the preview shows the same daily chart as prod.
PUZZLE_SECRET=

# Behind Caddy: read the visitor's address from X-Forwarded-For (one proxy hop).
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# preview only: keep preview plays out of the real crowd. Leave unset on prod.
# PLAY_SOURCE=dev
