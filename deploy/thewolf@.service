# systemd template for the app. One instance per slot:
#   thewolf@prod     the live game     (port 3000)
#   thewolf@preview  the PR preview    (port 3001)
#
# Install: sudo cp deploy/thewolf@.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable thewolf@prod thewolf@preview
#
# Settings come from /etc/thewolf/<slot>.env (root-owned, mode 600, never in the repo).
# The preview's DATABASE_URL changes on every preview deploy, so CI writes it to
# /srv/thewolf/<slot>/shared/runtime.env, which is read second and wins.

[Unit]
Description=The Wolf (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thewolf
Group=thewolf
WorkingDirectory=/srv/thewolf/%i/current
EnvironmentFile=/etc/thewolf/%i.env
EnvironmentFile=-/srv/thewolf/%i/shared/runtime.env
ExecStart=/usr/bin/node build
Restart=on-failure
RestartSec=2

# The app only reads its release and talks to the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadOnlyPaths=/srv/thewolf

[Install]
WantedBy=multi-user.target
