# Copy to .env for local development. In production and Previews these are Worker secrets.

# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth. 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# Keys the daily puzzle order and the Name it options. Use production's value, or local dev
# schedules different puzzles than everyone else.
PUZZLE_SECRET=""

# Optional: 'dev' keeps plays from this deployment out of the real crowd. Defaults to 'dev'
# under `vite dev` and 'real' otherwise.
# PLAY_SOURCE="dev"

# Optional, only for `npm run prices fetch`: a Tiingo API key.
# TIINGO_API_KEY=""
