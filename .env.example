# Tiger Data (PostgreSQL + TimescaleDB). Keep sslmode=require.
DATABASE_URL="postgres://user:password@host:port/tsdb?sslmode=require"

# Public base URL of the app (production).
ORIGIN="http://localhost:5173"

# Better Auth. Use 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Optional: shuffles the daily puzzle order (falls back to BETTER_AUTH_SECRET).
PUZZLE_SECRET=""

# Optional: tag plays from this server. "dev" keeps local test plays out of the real crowd.
PLAY_SOURCE=""

# Tiingo, used only by scripts/fetch-prices.ts (never at runtime).
TIINGO_API_KEY=""
